---
type Props = {
  eyebrow: string;
  title: string;
  lead?: string;
};
const { eyebrow, title, lead } = Astro.props;
---
<div class="mb-8 max-w-3xl">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="heading mt-3 text-3xl md:text-5xl">{title}</h2>
  {lead && <p class="mt-4 text-soft">{lead}</p>}
</div>
