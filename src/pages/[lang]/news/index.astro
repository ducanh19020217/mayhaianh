---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { filterByLanguage, isLanguage, localized } from '../../../lib/i18n';

export function getStaticPaths() {
  return ['en', 'zh'].map((lang) => ({ params: { lang } }));
}

const lang = isLanguage(Astro.params.lang) ? Astro.params.lang : 'en';
const t = localized[lang];
const posts = filterByLanguage(await getCollection('blog'), lang).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tags = Array.from(new Set(posts.flatMap((post) => post.data.tags))).sort((a, b) => a.localeCompare(b, 'vi'));
---
<BaseLayout lang={lang} title={lang === 'zh' ? '新闻 | Hải Anh Textile' : 'News | Hải Anh Textile'} description={lang === 'zh' ? '出口服装制造运营文章。' : 'Articles about export garment manufacturing operations.'}>
  <section class="container py-12 md:py-16">
    <p class="eyebrow">{lang === 'zh' ? '新闻' : 'News'}</p>
    <h1 class="heading mt-4 max-w-4xl text-5xl md:text-7xl">{t.newsTitle}</h1>
  </section>
  <div class="stitch-line" aria-hidden="true"></div>
  <section class="container py-4" data-post-browser>
    <div class="filter-panel mb-6 grid gap-4 border border-line p-4 md:grid-cols-[1fr_1.4fr]">
      <div>
        <label class="font-mono text-xs text-primary" for="post-search">{t.searchPosts}</label>
        <input id="post-search" data-post-search class="mt-2 w-full border border-line bg-bg px-3 py-3 text-sm" type="search" autocomplete="off" />
      </div>
      <div>
        <p class="font-mono text-xs text-primary">{t.filterTag}</p>
        <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Filter posts by tag">
          <button class="btn btn-primary min-h-10 px-3 py-2 text-sm" type="button" data-tag-filter="all" aria-pressed="true">{t.all}</button>
          {tags.map((tag) => (
            <button class="btn btn-plain min-h-10 px-3 py-2 text-sm" type="button" data-tag-filter={tag} aria-pressed="false">{tag}</button>
          ))}
        </div>
      </div>
    </div>
    <p class="mb-4 font-mono text-xs text-soft" data-post-count>{posts.length} {t.postUnit}</p>
    <div class="grid gap-5 md:grid-cols-2">
      {posts.map((post) => (
        <a href={`${t.news}${post.id}/`} class="product-card thread-hover border border-line p-5" data-post-card data-tags={post.data.tags.map((tag) => tag.toLocaleLowerCase('vi-VN')).join('|')} data-search={`${post.data.title} ${post.data.description} ${post.data.excerpt} ${post.data.tags.join(' ')}`.toLocaleLowerCase('vi-VN')}>
          <p class="font-mono text-xs text-primary">{post.data.date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US')}</p>
          <h2 class="mt-3 text-2xl font-semibold">{post.data.title}</h2>
          <p class="mt-3 text-sm text-soft">{post.data.excerpt}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => <span class="border border-line px-2 py-1 font-mono text-xs text-soft">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
    <p class="hidden border border-line p-5 text-soft" data-empty-state>{t.noPosts}</p>
  </section>
  <script>
    const browser = document.querySelector('[data-post-browser]');
    const searchInput = browser?.querySelector<HTMLInputElement>('[data-post-search]');
    const filterButtons = Array.from(browser?.querySelectorAll('[data-tag-filter]') ?? []);
    const cards = Array.from(browser?.querySelectorAll('[data-post-card]') ?? []);
    const count = browser?.querySelector('[data-post-count]');
    const emptyState = browser?.querySelector('[data-empty-state]');
    let activeTag = 'all';
    function applyFilters() {
      const query = searchInput?.value.trim().toLocaleLowerCase('vi-VN') ?? '';
      let visibleCount = 0;
      cards.forEach((card) => {
        const tags = card.getAttribute('data-tags') ?? '';
        const haystack = card.getAttribute('data-search') ?? '';
        const tagMatch = activeTag === 'all' || tags.split('|').includes(activeTag.toLocaleLowerCase('vi-VN'));
        const searchMatch = !query || haystack.includes(query);
        const isVisible = tagMatch && searchMatch;
        card.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      });
      if (count) count.textContent = `${visibleCount} ${document.documentElement.lang === 'zh-CN' ? '篇文章' : 'articles'}`;
      emptyState?.classList.toggle('hidden', visibleCount !== 0);
    }
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeTag = button.getAttribute('data-tag-filter') ?? 'all';
        filterButtons.forEach((item) => {
          const isActive = item === button;
          item.setAttribute('aria-pressed', String(isActive));
          item.classList.toggle('btn-primary', isActive);
          item.classList.toggle('btn-plain', !isActive);
        });
        applyFilters();
      });
    });
    searchInput?.addEventListener('input', applyFilters);
  </script>
</BaseLayout>
